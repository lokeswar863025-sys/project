# Backend Environment Template
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
TAX_RATE_PERCENT=5
# Optional: comma-separated browser origins allowed to call the API directly.
# Leave unset when the frontend is served by this same Express app or Vite proxy.
# CORS_ORIGIN=https://your-site.example
